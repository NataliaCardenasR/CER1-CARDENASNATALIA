CREATE TABLE IF NOT EXISTS Persona (
    idPersona INTEGER PRIMARY KEY,
    idTelefono INTEGER,
    idMail INTEGER,
    Nombre TEXT NOT NULL,
    Apellido TEXT NOT NULL,
    Alias TEXT,
    FOREIGN KEY (idTelefono) REFERENCES Telefono(idTelefono),
    FOREIGN KEY (idMail) REFERENCES Mail(idMail)
);

CREATE TABLE IF NOT EXISTS Telefono (
    idTelefono INTEGER PRIMARY KEY,
    idPersona INTEGER,
    telefono TEXT NOT NULL,
    FOREIGN KEY (idPersona) REFERENCES Persona(idPersona)
);

CREATE TABLE IF NOT EXISTS Mail (
    idMail INTEGER PRIMARY KEY,
    idPersona INTEGER,
    mail TEXT NOT NULL,
    FOREIGN KEY (idPersona) REFERENCES Persona(idPersona)
);

CREATE TABLE IF NOT EXISTS Vendedor (
    idVendedor INTEGER PRIMARY KEY,
    idPersona INTEGER NOT NULL,
    Cargo TEXT NOT NULL,
    FOREIGN KEY (idPersona) REFERENCES Persona(idPersona)
);

CREATE TABLE IF NOT EXISTS Cuenta (
    idCuenta INTEGER PRIMARY KEY,
    idPersona INTEGER NOT NULL,
    EstadoCuenta INTEGER NOT NULL,
    FOREIGN KEY (idPersona) REFERENCES Persona(idPersona)
);

CREATE TABLE IF NOT EXISTS Vehiculo (
    idVehiculo INTEGER PRIMARY KEY,
    Marca TEXT NOT NULL,
    Modelo TEXT NOT NULL,
    Año INTEGER NOT NULL,
    Motor TEXT NOT NULL,
    Traccion TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS Ingreso (
    idIngreso INTEGER PRIMARY KEY,
    idCuenta INTEGER NOT NULL,
    idVendedor INTEGER NOT NULL,
    idVehiculo INTEGER NOT NULL,
    Fecha TEXT NOT NULL,
    FOREIGN KEY (idCuenta) REFERENCES Cuenta(idCuenta),
    FOREIGN KEY (idVendedor) REFERENCES Vendedor(idVendedor),
    FOREIGN KEY (idVehiculo) REFERENCES Vehiculo(idVehiculo)
);

CREATE TABLE IF NOT EXISTS DetallePedido (
    idDetallePedido INTEGER,
    idIngreso INTEGER,
    Repuesto TEXT NOT NULL,
    Precio REAL NOT NULL,
    EstadoRepuesto INTEGER NOT NULL,
    PRIMARY KEY (idDetallePedido, idIngreso),
    FOREIGN KEY (idIngreso) REFERENCES Ingreso(idIngreso)
);
